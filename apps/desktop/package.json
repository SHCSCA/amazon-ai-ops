{
  "name": "@amazon-ai-ops/desktop",
  "version": "1.5.0",
  "description": "Amazon AI Ops Agent - 亚马逊广告运营自动化工具",
  "author": "Amazon AI Ops Team",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron .",
    "build:main": "node scripts/build-main.js && node -e \"require('fs').copyFileSync('dist/main/index.cjs','dist/main/index.js')\"",
    "build:preload": "node scripts/build-preload.js && node -e \"require('fs').copyFileSync('dist/preload/index.cjs','dist/preload/index.js')\"",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && electron-builder",
    "build:win": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^1.0.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@amazon-ai-ops/action-executor": "workspace:*",
    "@amazon-ai-ops/ai-adapter": "workspace:*",
    "@amazon-ai-ops/audit-log": "workspace:*",
    "@amazon-ai-ops/browser-worker": "workspace:*",
    "@amazon-ai-ops/keyword-opportunity": "workspace:*",
    "@amazon-ai-ops/lingxing-report-collector": "workspace:*",
    "@amazon-ai-ops/listing-analyzer": "workspace:*",
    "@amazon-ai-ops/local-db": "workspace:*",
    "@amazon-ai-ops/page-models": "workspace:*",
    "@amazon-ai-ops/report-parser": "workspace:*",
    "@amazon-ai-ops/rules-engine": "workspace:*",
    "@amazon-ai-ops/scheduler": "workspace:*",
    "@amazon-ai-ops/shared-types": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "esbuild": "^0.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "extends": "../../electron-builder.yml"
  }
}
