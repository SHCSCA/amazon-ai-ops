{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amazon-ai-ops.local/schemas/v16_evidence.schema.json",
  "title": "V16 Evidence Record",
  "description": "Common envelope for all v1.6.0 evidence files under output/v16-evidence/. Validated by scripts/verify-v16-l1-unit-contract.js, verify-v16-l2-static.js, verify-v16-l3-business-dev.js, etc. See docs/v16_companion_verification_traceability.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "producer",
    "verifier",
    "result",
    "resultDetail",
    "identity",
    "producedAt",
    "consumedInputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v16.evidence/0.1",
      "description": "Evidence envelope schema version. Verifiers must refuse mismatched versions."
    },
    "evidenceKind": {
      "type": "string",
      "enum": [
        "manifest-validation",
        "trace-closure",
        "l1-unit-contract",
        "l2-static-engineering",
        "l3-business-integration-dev",
        "l4-package-ui",
        "l5-package-security",
        "l6-formal-db",
        "l7-canary",
        "l8-readiness-aggregation"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "command", "host", "exitCode"],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer" }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "exitCode", "validatedAt"],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer" },
        "validatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "PENDING", "BLOCKED"]
    },
    "resultDetail": {
      "type": "string",
      "description": "Free-form diagnostic, verifier-set only. Operators must not edit this field."
    },
    "identity": { "$ref": "#/definitions/identity" },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "consumedInputs": {
      "type": "array",
      "items": { "$ref": "#/definitions/consumedInput" }
    },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/definitions/testResult" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/definitions/blocker" }
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRevision", "packageVersion"],
      "properties": {
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "description": "git commit SHA, or uncommitted:<ISO timestamp>."
        },
        "packageVersion": {
          "type": "string",
          "pattern": "^v16\\.\\d+\\.\\d+"
        },
        "packageSha256": {
          "type": "object",
          "additionalProperties": false,
          "description": "Required only for L4/L5/L8 evidence.",
          "properties": {
            "installer": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
            "portable": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
            "folderZip": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
            "winUnpackedExe": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
            "mainBundle": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
          }
        },
        "dbIdentity": {
          "type": "object",
          "additionalProperties": false,
          "description": "Required only for L6 evidence.",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
            "schemaVersion": { "type": "string", "minLength": 1 },
            "storeCount": { "type": "integer", "minimum": 0 },
            "productionFullLineage": { "type": "boolean" }
          }
        }
      }
    },
    "consumedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "sha256"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["sourceRevision", "packageArtifact", "dbSnapshot", "fixture", "manifest"]
        },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$",
          "description": "Uppercase hex SHA-256 of the file content."
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "result"],
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "^V16-T-[A-Z0-9_-]+$"
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL", "PENDING", "BLOCKED"]
        },
        "details": { "type": "string" },
        "blockingGates": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "target"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "message": { "type": "string", "minLength": 1 },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "testId, bucketId, or acceptanceId this blocker affects."
        }
      }
    }
  }
}
