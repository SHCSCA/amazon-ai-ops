{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amazon-ai-ops.local/schemas/v16_evidence.schema.json",
  "title": "V1.6 executed runner evidence",
  "description": "Version 1 contract. Runtime verifiers additionally recompute runner results and bind current source, package and retained artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "testId",
    "layer",
    "identity",
    "execution",
    "artifact",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v16.evidence/1"
    },
    "testId": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7"
      ]
    },
    "identity": {
      "$ref": "#/definitions/identity"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "finishedAt",
        "exitCode"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "sha256"
      ],
      "properties": {
        "format": {
          "enum": [
            "vitest-json",
            "checks-json"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "total",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRevision",
        "sourceSha256",
        "packageVersion"
      ],
      "properties": {
        "sourceRevision": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "packageHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "installer",
            "portable",
            "zip",
            "appContent",
            "mainBundle"
          ],
          "properties": {
            "installer": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "portable": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "zip": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "appContent": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "mainBundle": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
