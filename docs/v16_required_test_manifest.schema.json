{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amazon-ai-ops.local/schemas/v16_required_test_manifest.schema.json",
  "title": "V1.6 required test definition and run manifest",
  "description": "Version 1 contract. Runtime verifiers additionally recompute runner results and bind current source, package and retained artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "prdReference",
    "companionSpec",
    "requiredTests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v16.manifest/1"
    },
    "prdReference": {
      "type": "string",
      "minLength": 1
    },
    "companionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "$ref": "v16_evidence.schema.json#/definitions/identity"
    },
    "requiredTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testId",
          "layer",
          "format",
          "requirementIds"
        ],
        "properties": {
          "testId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6",
              "L7"
            ]
          },
          "format": {
            "enum": [
              "vitest-json",
              "checks-json"
            ]
          },
          "testFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requiredChecks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidencePath": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "format": {
                  "const": "vitest-json"
                }
              }
            },
            "then": {
              "required": [
                "testFiles"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "format": {
                  "const": "checks-json"
                }
              }
            },
            "then": {
              "required": [
                "requiredChecks"
              ]
            }
          }
        ]
      }
    }
  }
}
