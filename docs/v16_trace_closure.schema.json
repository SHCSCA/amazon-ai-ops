{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amazon-ai-ops.local/schemas/v16_trace_closure.schema.json",
  "title": "V1.6 current MUST closure",
  "description": "Version 1 contract. Runtime verifiers additionally recompute runner results and bind current source, package and retained artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "success",
    "issues",
    "total",
    "completed",
    "details"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v16.trace-closure/1"
    },
    "identity": {
      "$ref": "v16_evidence.schema.json#/definitions/identity"
    },
    "success": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "completed": {
      "type": "integer",
      "minimum": 0
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "success",
          "issues"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "success": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
