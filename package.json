{
  "name": "@amazon-ai-ops/root",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @amazon-ai-ops/desktop run dev",
    "build": "pnpm --filter @amazon-ai-ops/desktop run build",
    "build:win": "pnpm --filter @amazon-ai-ops/desktop run build:win",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "verify:v15-diagnostic": "node scripts/verify-v15-diagnostic-evidence.js",
    "verify:v15-canary": "node scripts/verify-v15-canary-evidence.js",
    "verify:v15-enablement": "node scripts/verify-v15-enablement-evidence.js",
    "write:v15-evidence-manifest": "node scripts/write-v15-evidence-manifest.js",
    "verify:v15-final-readiness": "node scripts/verify-v15-final-readiness.js",
    "verify:v15-non-ready-safety": "node scripts/verify-v15-non-ready-safety.js",
    "verify:v15-ready-safety": "node scripts/verify-v15-ready-safety.js",
    "verify:ad-execution": "node scripts/verify-ad-execution-fail-closed.js",
    "verify:ad-readback": "node scripts/verify-ad-readback-evidence.js",
    "create:ad-readback-template": "node scripts/create-ad-readback-evidence-template.js",
    "create:ad-readback-candidate": "node scripts/create-ad-readback-candidate-from-recommendation.js",
    "prepare:ad-readback-session": "node scripts/prepare-ad-readback-session.js",
    "verify:ad-readback-session": "node scripts/verify-ad-readback-session.js",
    "fill:ad-readback-session": "node scripts/fill-ad-readback-session.js",
    "fill:ad-readback": "node scripts/fill-ad-readback-evidence.js",
    "verify:ad-ai-explanation": "node scripts/verify-ad-ai-explanation-evidence.js",
    "verify:ai-live": "node scripts/verify-ai-live-connection.js",
    "run:ai-structural-mock": "node scripts/run-ai-structural-mock.js",
    "verify:ai-structural-mock": "node scripts/verify-ai-structural-mock-evidence.js",
    "verify:listing-ai-draft": "node scripts/verify-listing-ai-draft-evidence.js",
    "verify:listing-draft-ux": "node scripts/verify-listing-draft-ux.js",
    "verify:listing-read": "node scripts/verify-listing-read-evidence.js",
    "verify:ai-settings-ux": "node scripts/verify-ai-settings-ux.js",
    "smoke:listing-draft-renderer": "node scripts/smoke-listing-draft-renderer.js",
    "smoke:business-ui-current": "node scripts/smoke-current-business-ui.js",
    "smoke:v15-product-readiness-ui": "pnpm run smoke:business-ui-current",
    "verify:v15-delivery": "node scripts/verify-ad-execution-fail-closed.js && node scripts/verify-v15-delivery-evidence.js",
    "reconcile:v15-full8-data": "node scripts/reconcile-lingxing-full8-data.js",
    "export:v15-delivery-bundle": "node scripts/export-v15-delivery-bundle.js",
    "run:v15-installed-live": "node scripts/run-v15-installed-live.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
